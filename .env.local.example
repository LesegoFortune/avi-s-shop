# --- WhatsApp -----------------------------------------------------------------
# Your number in full international format, digits only.
# South African example: 082 123 4567  ->  27821234567
NEXT_PUBLIC_WHATSAPP_NUMBER=27788287195

# --- Supabase ----------------------------------------------------------------
# From your project's Settings -> API page. Both are safe to expose publicly;
# row-level security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Admin lock (optional but recommended) -----------------------------------
# Comma-separated emails allowed into /admin. Leave blank to allow any
# Supabase account you create.
ADMIN_EMAILS=
